#include <Arduino.h>
#include "driver/gpio.h"
#include <stdint.h>

#define potrojo GPIO_NUM_34
#define potverde GPIO_NUM_35

#define ledrojo 32
#define ledverde 33
#define ledazul 25

uint16_t valorRojo = 0;
uint16_t valorVerde = 0;

uint8_t rojo = 0;
uint8_t verde = 0;

void setup() {

    Serial.begin(115200);

    analogReadResolution(12);
    analogSetAttenuation(ADC_11db);

    pinMode(ledrojo, OUTPUT);
    pinMode(ledverde, OUTPUT);
    pinMode(ledazul, OUTPUT);

    analogWrite(ledazul, 0);
}

void loop() {

    valorRojo = analogRead(potrojo);
    valorVerde = analogRead(potverde);

    rojo = map(valorRojo, 0, 4095, 0, 255);
    verde = map(valorVerde, 0, 4095, 0, 255);

    Serial.print("Rojo: ");
    Serial.print(rojo);

    Serial.print("    Verde: ");
    Serial.println(verde);

    analogWrite(ledrojo, rojo);
    analogWrite(ledverde, verde);

    delay(500);
}
